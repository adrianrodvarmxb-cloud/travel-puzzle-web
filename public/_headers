# REQ-1530: caché del navegador para estáticos (Cloudflare Workers Static Assets).
# El HTML y /api/* no se tocan aquí: siguen dinámicos.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/home/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/logo-*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/maplibre/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

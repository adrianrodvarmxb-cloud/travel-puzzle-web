// Esquema de Prisma para Cloudflare D1 (SQLite).
// Las migraciones viejas de MySQL quedan en prisma/migrations-mysql-legacy como referencia.
generator client {
  provider   = "prisma-client-js"
  // Sin motor nativo: corre en Cloudflare Workers con el adaptador de D1
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String? // Optional for OAuth users
  name      String?
  role      Role      @default(CLIENT)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ============================================
// FREETOUR API MODELS - Multilingual Support
// ============================================

// Country Model
model Country {
  id           Int    @id
  code         String @unique
  translations Json? // Store translations as JSON: { "en": "Hungary", "es": "Hungría", ... }
  cities       City[]
  tours        Tour[]
}

// City Model
model City {
  id           Int     @id
  countryId    Int
  country      Country @relation(fields: [countryId], references: [id])
  translations Json? // Store translations as JSON: { "en": "Paris", "es": "París", ... }
  tours        Tour[]

  @@index([countryId])
}

// Tour Model (Refactored for FreeTour API)
model Tour {
  id            String            @id @default(cuid())
  externalId    Int               @unique
  providerTitle String
  providerPhone String?
  priceValue    Decimal
  priceCurrency String
  duration      String
  titleImageURL String?
  categoryId    Int
  rating        Decimal?
  reviewsNumber Int               @default(0)
  cityId        Int
  city          City              @relation(fields: [cityId], references: [id])
  countryId     Int
  country       Country           @relation(fields: [countryId], references: [id])
  meetingPoint  Json // Store MeetingPoint as JSON
  includes      Json // Store includes array as JSON
  POIs          Json? // Store POIs as JSON
  images        Json // Store images array as JSON
  videoURL      String?
  translations  TourTranslation[]
  bookings      Booking[]
  isActive      Boolean           @default(true)
  lastSeenAt    DateTime? // última corrida diaria en la que apareció en la API
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())

  @@index([cityId])
  @@index([countryId])
  @@index([categoryId])
  @@index([isActive])
  @@index([priceValue])
}

model TourTranslation {
  id          String  @id @default(cuid())
  tourId      String
  language    String
  title       String
  brief       String?
  description String?
  url         String
  tour        Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, language])
  @@index([language])
  @@index([title])
}

// Sync Metadata for tracking API syncs
model SyncMetadata {
  id           String    @id @default(cuid())
  provider     String    @unique
  lastSyncAt   DateTime
  toursCount   Int
  status       String
  nextPage     Int       @default(1) // siguiente página a sincronizar
  totalPages   Int       @default(0)
  runStartedAt DateTime? // inicio de la corrida del día
}

// Booking Model
model Booking {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId        String
  tour          Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  totalAmount   Decimal
  externalUrl   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([tourId])
  @@index([status])
}

// API Provider Model
model ApiProvider {
  id        String   @id @default(cuid())
  name      String   @unique
  apiKey    String
  apiSecret String?
  endpoint  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Enums
enum Role {
  CLIENT
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

// Reseñas reales de Freetour (GET /tours/{id}/reviews), en caché por tour.
model Review {
  id             Int      @id // id de la reseña en Freetour
  tourExternalId Int // Tour.externalId
  reviewerName   String
  language       String
  title          String?
  content        String?
  rate           Float
  addedAt        DateTime
  fetchedAt      DateTime @default(now())

  @@index([tourExternalId, addedAt])
  @@index([rate])
}

// Control de la caché de reseñas por tour.
model ReviewCache {
  tourExternalId Int      @id
  totalObjects   Int
  fetchedAt      DateTime
}

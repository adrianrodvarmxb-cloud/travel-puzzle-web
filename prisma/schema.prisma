// This is your Prisma schema file for MySQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  password  String?  @db.VarChar(255) // Optional for OAuth users
  name      String?  @db.VarChar(255)
  role      Role     @default(CLIENT)
  bookings  Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// FREETOUR API MODELS - Multilingual Support
// ============================================

// Country Model
model Country {
  id           Int      @id
  code         String   @unique @db.VarChar(10)
  translations Json?    // Store translations as JSON: { "en": "Hungary", "es": "Hungría", ... }
  cities       City[]
  tours        Tour[]
}

// City Model
model City {
  id           Int      @id
  countryId    Int
  country      Country  @relation(fields: [countryId], references: [id])
  translations Json?   // Store translations as JSON: { "en": "Paris", "es": "París", ... }
  tours        Tour[]

  @@index([countryId])
}

// Tour Model (Refactored for FreeTour API)
model Tour {
  id              String            @id @default(cuid())
  externalId      Int               @unique
  providerTitle   String            @db.VarChar(255)
  providerPhone   String?           @db.VarChar(50)
  priceValue      Decimal           @db.Decimal(10, 2)
  priceCurrency   String            @db.VarChar(3)
  duration        String            @db.VarChar(20)
  titleImageURL   String?           @db.Text
  categoryId      Int
  rating          Decimal?          @db.Decimal(3, 2)
  reviewsNumber   Int               @default(0)
  cityId          Int
  city            City              @relation(fields: [cityId], references: [id])
  countryId       Int
  country         Country           @relation(fields: [countryId], references: [id])
  meetingPoint    Json              // Store MeetingPoint as JSON
  includes        Json              // Store includes array as JSON
  POIs            Json?             // Store POIs as JSON
  images          Json              // Store images array as JSON
  videoURL        String?           @db.Text
  translations    TourTranslation[]
  bookings        Booking[]
  isActive        Boolean           @default(true)
  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())

  @@index([cityId])
  @@index([countryId])
  @@index([categoryId])
  @@index([isActive])
  @@index([priceValue])
}

model TourTranslation {
  id          String  @id @default(cuid())
  tourId      String
  language    String  @db.VarChar(2)
  title       String  @db.VarChar(500)
  brief       String? @db.Text
  description String? @db.Text
  url         String  @db.Text
  tour        Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, language])
  @@index([language])
  @@index([title])
}

// Sync Metadata for tracking API syncs
model SyncMetadata {
  id         String   @id @default(cuid())
  provider   String   @unique @db.VarChar(100)
  lastSyncAt DateTime
  toursCount Int
  status     String   @db.VarChar(50)
}

// Booking Model
model Booking {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId        String
  tour          Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  totalAmount   Decimal       @db.Decimal(10, 2)
  externalUrl   String?       @db.VarChar(500)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([tourId])
  @@index([status])
}

// API Provider Model
model ApiProvider {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  apiKey      String   @db.Text
  apiSecret   String?  @db.Text
  endpoint    String   @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Enums
enum Role {
  CLIENT
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

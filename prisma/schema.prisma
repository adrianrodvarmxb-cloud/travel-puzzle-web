// Esquema de Prisma para Cloudflare D1 (SQLite).
// Las migraciones viejas de MySQL quedan en prisma/migrations-mysql-legacy como referencia.
generator client {
  provider   = "prisma-client-js"
  // Sin motor nativo: corre en Cloudflare Workers con el adaptador de D1
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String? // Optional for OAuth users
  name      String?
  role      Role      @default(CLIENT)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ============================================
// FREETOUR API MODELS - Multilingual Support
// ============================================

// Country Model
model Country {
  id           Int    @id
  code         String @unique
  iso2         String? @unique // REQ-085: ISO 3166-1 alfa-2 en mayúsculas (migración 0015)
  translations Json? // Store translations as JSON: { "en": "Hungary", "es": "Hungría", ... }
  cities       City[]
  tours        Tour[]
}

// City Model
model City {
  id           Int     @id
  countryId    Int
  country      Country @relation(fields: [countryId], references: [id])
  translations Json? // Store translations as JSON: { "en": "Paris", "es": "París", ... }
  tours        Tour[]
  // Ola 3 (migración 0015)
  geonameid      Int? // REQ-085: id de GeoNames (cruce automático + revisión, gate 3)
  slug           String? // REQ-086/087: único dentro del país; homónimas con código de estado
  stateCode      String? // REQ-087: código de estado para homónimas (BCS)
  guide          String? // guía propia de la ciudad (≥ 300 palabras, REQ-089)
  guideUpdatedAt DateTime?
  indexableSince DateTime? // REQ-090: desde cuándo es indexable (null = noindex)
  failingSince   DateTime? // REQ-090: primer día sin cumplir la regla; al día 14 pasa a noindex
  providerCities ProviderCity[] // REQ-3369: destinos de proveedores que apuntan a esta ciudad

  @@unique([countryId, slug])
  @@index([countryId])
  @@index([geonameid])
}

// REQ-3369 (Tangol ola 2, gate B; decisión REQ-1624): mapeo destino del proveedor → ciudad de Travel Puzzle.
// La crea migrations/0028_provider_city.sql, que NO está aplicada (candado del PO).
// source: geonames | nombre (cruce, REQ-1606) | nueva (ciudad creada en el plan) | manual (corrección del PO).
model ProviderCity {
  provider     String
  externalId   String
  cityId       Int
  city         City     @relation(fields: [cityId], references: [id])
  providerName String
  countryCode  String
  source       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([provider, externalId])
  @@index([cityId])
}

// Tour Model (Refactored for FreeTour API)
model Tour {
  id            String            @id @default(cuid())
  externalId    Int               // REQ-1623: único por (providerId, externalId) desde 0026, ya no solo
  providerId    String            @default("freetour") // REQ-085: llave natural (providerId, externalId)
  slug          String?           @unique // REQ-086: se guarda una vez; un trigger impide cambiarlo
  providerTitle String
  providerPhone String?
  priceValue    Decimal
  priceCurrency String
  duration      String
  durationMinutes Int? // minutos, calculado de duration ("H:MM") para ordenar y filtrar
  titleImageURL String?
  categoryId    Int
  rating        Decimal?
  reviewsNumber Int               @default(0)
  cityId        Int
  city          City              @relation(fields: [cityId], references: [id])
  countryId     Int
  country       Country           @relation(fields: [countryId], references: [id])
  meetingPoint  Json // Store MeetingPoint as JSON
  includes      Json // Store includes array as JSON
  POIs          Json? // Store POIs as JSON
  images        Json // Store images array as JSON
  videoURL      String?
  translations  TourTranslation[]
  bookings      Booking[]
  isActive      Boolean           @default(true)
  lastSeenAt    DateTime? // última corrida diaria en la que apareció en la API
  // REQ-049: resumen de salidas (idiomas del guía y fechas próximas), lo llena el sync escalonado de salidas
  guideLanguages      Json      @default("[]")
  departureDates      Json      @default("[]")
  departuresSyncedAt  DateTime?
  departuresCheckedAt DateTime?
  // Ola 1 (migración 0014, REQ-073/074): la base agrega "contentHash" TEXT, "syncStatus" TEXT ('active')
  // y "missingRuns" INTEGER (0). NO se declaran aquí a propósito: Prisma lee todas las columnas del
  // modelo en /tours y en la ficha, y si el código se publica antes de aplicar la 0014 la página
  // falla con «no such column» (prueba de humo del PR #104, 5 nov 2026). Solo el sync blindado las
  // usa, con SQL directo. Se declaran aquí cuando el render las necesite (Ola 4), con la 0014 ya aplicada.
  updatedAt     DateTime          @updatedAt
  createdAt     DateTime          @default(now())

  @@index([cityId])
  @@index([countryId])
  @@index([categoryId])
  @@index([isActive])
  @@index([priceValue])
  @@index([durationMinutes])
  @@index([isActive, reviewsNumber])
  @@index([isActive, countryId])
  @@index([isActive, cityId])
  @@index([isActive, rating])
  @@index([isActive, departuresCheckedAt])
  @@unique([providerId, externalId])
}

model TourTranslation {
  id          String  @id @default(cuid())
  tourId      String
  language    String
  title       String
  brief       String?
  description String?
  url         String
  tour        Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, language])
  @@index([language])
  @@index([title])
}

// Sync Metadata for tracking API syncs
model SyncMetadata {
  id           String    @id @default(cuid())
  provider     String    @unique
  lastSyncAt   DateTime
  toursCount   Int
  status       String
  nextPage     Int       @default(1) // siguiente página a sincronizar
  totalPages   Int       @default(0)
  runStartedAt DateTime? // inicio de la corrida del día
}

/// Ola 1 (migración 0014, REQ-072/078): log y avance de cada corrida del sync blindado.
model SyncRun {
  id            String    @id
  provider      String
  status        String // staging | publishing | succeeded | aborted
  startedAt     DateTime
  finishedAt    DateTime?
  nextPage      Int       @default(1)
  totalPages    Int       @default(0)
  failures      Int       @default(0)
  notBefore     DateTime?
  publishCursor Int       @default(0)
  baseline      Int       @default(0)
  seen          Int       @default(0)
  added         Int       @default(0)
  changed       Int       @default(0)
  ratingUpdates Int       @default(0)
  missing       Int       @default(0)
  removed       Int       @default(0)
  reactivated   Int       @default(0)
  abortReason   String?
  updatedAt     DateTime

  @@index([provider, startedAt])
  @@index([provider, status, finishedAt])
}

/// Ola 1 (migración 0014, REQ-071/072): staging por corrida; nada pasa a Tour hasta cruzar la barrera.
model TourStage {
  runId      String
  externalId Int
  hash       String
  kind       String // new | changed | rating | same
  payload    Json?
  previous   Json? // respaldo de la fila de Tour antes de sobrescribirla
  createdAt  DateTime

  @@id([runId, externalId])
  @@index([runId, kind, externalId])
}

// Booking Model
model Booking {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId        String
  tour          Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  totalAmount   Decimal
  externalUrl   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([tourId])
  @@index([status])
}

// API Provider Model
model ApiProvider {
  id        String   @id @default(cuid())
  name      String   @unique
  apiKey    String
  apiSecret String?
  endpoint  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Enums
enum Role {
  CLIENT
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

// Reseñas reales de Freetour (GET /tours/{id}/reviews), en caché por tour.
model Review {
  id             Int      @id // id de la reseña en Freetour
  tourExternalId Int // Tour.externalId
  reviewerName   String
  language       String
  title          String?
  content        String?
  rate           Float
  addedAt        DateTime
  fetchedAt      DateTime @default(now())

  @@index([tourExternalId, addedAt])
  @@index([rate])
}

// Control de la caché de reseñas por tour.
model ReviewCache {
  tourExternalId Int      @id
  totalObjects   Int
  fetchedAt      DateTime
  @@index([fetchedAt])
}

// Reservas confirmadas por Freetour (Modo 2), con o sin cuenta.
// manageToken = enlace privado del cliente para ver, cancelar o cambiar su reserva.
model FreetourBooking {
  refNumber      String   @id
  tourExternalId Int?
  eventId        Int
  adults         Int
  children       Int
  price          Float
  email          String
  firstName      String
  lastName       String
  phone          String?
  eventDate      String?
  eventUtcDate   String?
  language       String?
  status         String
  manageToken    String   @unique
  // Tours de pago (migración 0009): `price` es lo cobrado hoy; `fullPrice` el total del grupo.
  fullPrice         Float?
  currency          String?
  checkoutSessionId String?
  paymentUrl        String?
  paymentStatus     String? // pending | paid | canceled | review | expired
  paymentExpiresAt  String?
  paymentCheckedAt  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([eventId])
  @@index([status, eventUtcDate])
  @@index([paymentStatus])
}

/// Correos automáticos ya enviados por reserva (recordatorios y reseña).
model FreetourBookingEmail {
  refNumber String
  kind      String
  sentAt    DateTime @default(now())

  @@id([refNumber, kind])
}

/// Reseñas de clientes de Travel Puzzle (una por reserva). Se publican solo con consentimiento y aprobación.
model CustomerReview {
  id             String    @id @default(cuid())
  refNumber      String    @unique
  tourExternalId Int?
  rate           Int
  content        String    @default("")
  displayName    String
  consent        Boolean   @default(false)
  status         String    @default("pending") // pending | published | hidden
  language       String    @default("es")
  tourDate       String?
  moderatedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tourExternalId, status])
  @@index([status, createdAt])
}

// ============================================
// VIAJES PROPIOS Y DE AGENCIAS (punto 17, nov 2026)
// ============================================

// Agencias externas sin sitio propio cuyos viajes vende Travel Puzzle.
model Agency {
  id          String   @id @default(cuid())
  name        String   @unique
  initials    String?  @unique // siglas para el código de sus viajes (gate H)
  contactName String   @default("")
  email       String   @default("")
  phone       String   @default("")
  notes       String   @default("")
  isActive    Boolean  @default(true)
  trips       Trip[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Viaje del gestor (agencyId null = Travel Puzzle). status: draft | published | hidden (nunca se borra).
model Trip {
  id            String   @id @default(cuid())
  slug          String   @unique
  code          String   @unique
  agencyId      String?
  agency        Agency?  @relation(fields: [agencyId], references: [id])
  kind          String // tour | circuito | unica | personalizado
  purchaseMode  String   @default("quote") // quote | buy
  status        String   @default("draft")
  titleEs       String
  titleEn       String   @default("")
  summaryEs     String   @default("")
  summaryEn     String   @default("")
  descriptionEs String   @default("")
  descriptionEn String   @default("")
  countries     Json // string[]
  cities        Json // string[]
  durationDays  Int?
  priceFrom     Float?
  currency      String   @default("MXN")
  priceNote     String   @default("")
  dates         Json // [{ date, times[] }]
  meetingPoints Json // [{ name, address }]
  hotelPickup   Boolean  @default(false)
  itinerary     Json // [{ title, text }]
  includes      Json // string[]
  excludes      Json // string[]
  visaInfo      String   @default("")
  images        Json // [{ key, alt }]
  // Ola 1b (gates G-J): código automático, contenido GYG, opciones y disponibilidad
  seq             Int      @default(0)
  codeLocked      Boolean  @default(false)
  category        String?
  highlights      Json // string[]
  importantInfo   String   @default("")
  whatToBring     String   @default("")
  accessibility   String   @default("")
  difficulty      String?
  difficultyLevel Int?    // REQ-1520: nivel 1–5 revisado (columna de la migración 0018; REQ-1518/1519)
  flightsIncluded Boolean  @default(false)
  languages       Json // string[]
  minPax          Int?
  maxPax          Int?
  options         Json // [{ id, name, mode, adult, child, infant, childAgeMin, childAgeMax }]
  extras          Json // [{ name, price, perPerson }]
  availability    Json // { weekdays, slots, closedDates, seasons }
  minNoticeHours  Int      @default(24)
  cancellation    Json // { type, tiers }
  endPoint        String   @default("")
  videoUrl        String   @default("")
  videoCaption    String   @default("")
  translations    Json // { lang: { campo: { text, src, manual } } }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, kind])
  @@index([agencyId])
}

// Solicitudes de cotización de los viajes (punto 17, ola 2, gate M). status: new | contacted | quoted | closed.
model TripRequest {
  id          String   @id @default(cuid())
  ref         String   @unique
  tripId      String
  tripCode    String
  tripTitle   String
  kind        String // reserva | personalizado
  status      String   @default("new")
  date        String
  endDate     String?
  time        String   @default("")
  serviceType String?
  optionId    String?
  optionName  String?
  adults      Int
  children    Int      @default(0)
  infants     Int      @default(0)
  childAges   Json // number[]
  firstName   String
  lastName    String
  email       String
  phone       String
  hotel       String   @default("")
  comments    String   @default("")
  language    String   @default("es")
  estimate    Float?
  currency    String   @default("MXN")
  consent     Boolean  @default(true)
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([tripId])
}

// REQ-119: pagos con Stripe (ola 1). status: pending | paid | expired | replaced. Siempre en MXN (gate B1).
model Payment {
  id               String    @id
  requestId        String
  kind             String // anticipo | liquidacion | total
  amountCentavos   Int
  currency         String    @default("MXN")
  originalAmount   Float
  originalCurrency String
  fxRate           Float?
  fxCushionPct     Float     @default(0)
  stripeSessionId  String    @unique
  checkoutUrl      String
  paymentIntent    String?
  status           String    @default("pending")
  expiresAt        DateTime
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([requestId, status])
}

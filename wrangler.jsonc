{
  // Configuración del Worker de Travel Puzzle en Cloudflare.
  // Secretos (no van aquí): FREETOUR_EMAIL, FREETOUR_PASSWORD, CRON_SECRET, AUTH_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET → `wrangler secret put <NOMBRE>`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-puzzle-web",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  // Dominio propio (zona en Cloudflare).
  // Mantener viva la dirección workers.dev: correos ya enviados usan esas URLs (logos, "Mi reserva").
  "workers_dev": true,
  "routes": [
    { "pattern": "travelpuzzle.com.mx", "custom_domain": true },
    { "pattern": "www.travelpuzzle.com.mx", "custom_domain": true }
  ],
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "travel-puzzle-web" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-puzzle",
      // Base creada en el panel de Cloudflare (30 oct 2026)
      "database_id": "31470fbd-6df6-4f4d-9f45-0f696395d27b",
      "migrations_dir": "migrations"
    }
  ],
  // Fotos de los viajes propios y de agencias (punto 17). Bucket creado en el panel de Cloudflare.
  "r2_buckets": [
    { "binding": "TRIP_IMAGES", "bucket_name": "travel-puzzle-trips" }
  ],
  // IA de Cloudflare para traducir los viajes del gestor (punto 17, gate I). Cobro por uso.
  "ai": { "binding": "AI" },
  "vars": {
    // El catálogo se lee de producción (los tours reales). Las reservas pasan por la pasarela de Namecheap.
    "FREETOUR_ENV": "production",
    // REQ-062: versión de la API de Freetour. Sin la variable = "2.0" (hoy). Para 2.2 se agrega
    // "FREETOUR_API_VERSION": "2.2" solo con OK del PO y después de la pasarela (docs/plan-freetour-v22.md).
    // Auth.js fuera de Vercel necesita confiar en el host del Worker
    "AUTH_TRUST_HOST": "true",
    // Pasarela de reservas en el servidor de Namecheap (IP registrada en Freetour)
    "GATEWAY_URL": "https://pasarela.travelpuzzle.com.mx",
    // Interruptor de reservas reales. "true" solo con OK, después de probar en producción.
    "BOOKINGS_ENABLED": "true",
    // Correos de confirmación (Resend). "true" solo con OK; la llave va como secreto RESEND_API_KEY.
    "EMAILS_ENABLED": "true",
    // Correo post-tour pidiendo reseña: se enciende cuando exista la página de reseñas.
    "REVIEW_EMAILS_ENABLED": "false",
    // Tours de pago en recomendaciones (60 % pago / 40 % free): se enciende cuando el pago en línea esté activo.
    "PAID_TOURS_ENABLED": "false",
    // Modificar reserva en línea (/reserva/[token]/modificar): "true" cuando Freetour dé el permiso de editar.
    "EDIT_ENABLED": "true",
    // Viajes propios y de agencias en el sitio público (ficha /viajes, /tours, carrusel del home). "true" con OK del PO.
    "OWN_TOURS_ENABLED": "true",
    // Transporte (tipo M, p. ej. Big Bus bajo solicitud). Regreso: "false" (los viajes siguen en D1, solo se ocultan).
    "TRANSPORT_ENABLED": "true",
    // Lectura escalonada de salidas de Freetour (idiomas y fechas, REQ-049). "true" después de la migración 0012 y con OK.
    "DEPARTURES_SYNC_ENABLED": "true",
    // Mostrar filtros de idioma del guía y fecha (REQ-061). "true" cuando la lectura de salidas cubra el catálogo, con OK.
    "DEPARTURE_FILTERS_ENABLED": "true",
    // Buscador con relevancia (FTS5, REQ-048). "true" con vista previa y OK del PO, después de la migración 0011.
    "SEARCH_V2_ENABLED": "false",
    // Sync blindado de FREETOUR (Ola 1, REQ-071…078): staging, barrera del 20 %, hash, missing → removed, log y alerta de 26 h.
    // "true" solo después de aplicar la migración 0014 y con OK del PO. Apagado = sync de hoy, sin cambios.
    "SYNC_GUARD_ENABLED": "true",
    // Retención en tarjeta con Stripe al solicitar (REQ-059). "true" solo cuando el cobro diferido exista en producción.
    "STRIPE_HOLD_ENABLED": "false",
    // Enlace de pago de Stripe para solicitudes (REQ-114..119). "true" solo tras migración 0013, webhook creado y OK del PO.
    "STRIPE_ENABLED": "false",
    // Colchón de tipo de cambio para cobros en USD/EUR (gate B1).
    "STRIPE_FX_CUSHION_PCT": "3",
    // REQ-081: post-tour (correo o WhatsApp) que promueva tours de FREETOUR. "true" solo con autorización escrita en docs/freetour/autorizaciones.md.
    "FREETOUR_POSTTOUR_PROMO_ENABLED": "false",
    // REQ-081: chatbot (Mila u otro) que ofrezca o reserve tours de FREETOUR. "true" solo con autorización escrita.
    "FREETOUR_CHATBOT_ENABLED": "false",
    // Taxonomía T3 (REQ-406…408, REQ-261): Free tour = formato pieza-libre (sin 8, 17, 20, 24, 26, 28, 29, 30, 31, 35), sin online,
    // servicios ni categorías sin mapear en /destinos, /la-primera-pieza, sitemaps, inicio y venta cruzada; traslados de FREETOUR a Traslados.
    // "true" con preview, prueba de humo y OK del PO (después de PRIMERA_PIEZA_ENABLED, ya encendida).
    "TAXONOMY_PUBLISH_ENABLED": "true",
    // Taxonomía T4 (REQ-412, REQ-413): /tours con «Tipo de experiencia» (?formato=), sin chips en cero, noindex en combinaciones
    // y ?tipo_act= traducido. "true" con preview, prueba de humo y OK del PO (después de TAXONOMY_PUBLISH_ENABLED).
    "TAXONOMY_FILTERS_ENABLED": "true",
    // REQ-262…267: bloque de venta cruzada (sin FREETOUR, regla B3) en confirmación, recordatorios, cambio y post-tour.
    // Nunca en rechazo ni cancelación. "true" con preview, prueba de humo y OK del PO. Decisión del PO (6-11 09:07):
    // la única restricción es no promover FREETOUR; no se exige la lista «No publicidad».
    "EMAIL_CROSS_SELL_ENABLED": "false",
    // REQ-083: casilla «soy mayor de edad» obligatoria en la reserva. "true" con preview, prueba de humo y OK del PO.
    "ADULT_CONTACT_CHECK_ENABLED": "false",
    // REQ-084: casilla de marketing (LFPDPPP) en el registro. "true" con texto aprobado por PO y abogado y con el consentimiento guardado (migración).
    "MARKETING_CONSENT_ENABLED": "false",
    // REQ-084: página /cookies (borrador). "true" con texto aprobado por PO y abogado.
    "COOKIES_POLICY_ENABLED": "false",
    // REQ-139 (gate G5): atribución CC BY 4.0 de GeoNames, solo en /terminos (no en el pie). "true" cuando el geonameid
    // o datos de GeoNames se vean en el sitio (JSON-LD, hubs), con preview, prueba de humo y OK del PO.
    "GEO_ATTRIBUTION_ENABLED": "false",
    // REQ-221 (PO, 6 nov 2026): ENCENDIDA. REQ-148..152: ventana de solo lectura del catálogo para el agente de WhatsApp (ZoeFel IA). Con OK
    // del PO; la llave AGENTE_TOKEN viaja con la versión (REQ-188).
    "AGENTE_API_ENABLED": "true",
    "TRANSFERS_ENABLED": "true",
    "AFFILIATES_ENABLED": "true",
    // La Primera Pieza (REQ-093, REQ-103): menú con La Primera Pieza y Destinos, y /llms.txt. "true" solo cuando
    // existan /la-primera-pieza y /destinos (Olas 3 y 4), con preview, prueba de humo y OK del PO.
    "PRIMERA_PIEZA_ENABLED": "true",
    // Carruseles del home (REQ-450, REQ-453): «Los más elegidos» por medidor de reseñas (bayesiano, cualquier proveedor)
    // y «Excursiones de un día». "true" con preview con la bandera encendida, prueba de humo y OK del PO.
    "CARRUSELES_HOME_ENABLED": "true",
    "AFFILIATE_PATHS": "/trenes,/traslados",
    // «Arma tu viaje» y carrusel de acompañamiento (REQ-104…110). Apagada = /arma-tu-viaje responde 404. "true" con preview y OK del PO.
    "ARMA_TU_VIAJE_ENABLED": "false",
    // Cobros del carrito por adaptador (paymentUrl de Stripe, REQ-107). Candado de pagos: "true" solo con OK del PO.
    "CART_PAYMENTS_ENABLED": "false",
    // Tarjetas de asesoría de visa y ETIAS en el carrusel (REQ-109). "true" con OK del PO.
    "VISA_ENABLED": "false",
    "ETIAS_ENABLED": "false",
    "EMAIL_FROM": "Travel Puzzle <reservas@travelpuzzle.com.mx>",
    "EMAIL_REPLY_TO": "info@travelpuzzle.com.mx",
    // Dirección pública del sitio (para los enlaces de los correos). Cambia al pasar el dominio.
    "SITE_URL": "https://travelpuzzle.com.mx",
    // WhatsApp Business de Travel Puzzle (solo dígitos, formato internacional)
    "WHATSAPP_NUMBER": "525536490320",
    // Redes sociales de Travel Puzzle (aparecen en el pie de los correos)
    "SOCIAL_INSTAGRAM": "https://www.instagram.com/travelpuzzle/",
    "SOCIAL_FACEBOOK": "https://www.facebook.com/travelpuzzle",
    "SOCIAL_TIKTOK": "https://www.tiktok.com/@travelpuzzle",
    "SOCIAL_YOUTUBE": "https://www.youtube.com/@travelpuzzle"
  },
  "triggers": {
    // Cada minuto. El catálogo arranca a diario a las 3:00 a. m. (CDMX); el resto del tiempo actualiza reseñas.
    "crons": ["* * * * *"]
  },
  "observability": { "enabled": true }
}
